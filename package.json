    "extract-zip": "^2.0.1",
    "googleapis": "^171.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.562.0",
    "node-schedule": "^2.1.1",
    "react-hook-form": "^7.71.1",
    "read-excel-file": "^6.0.1",
    "recharts": "^3.8.0",
    "serialport": "^13.0.0",
    "update-electron-app": "^3.1.2",
    "usb": "^2.17.0",
    "winston": "^3.19.0",
