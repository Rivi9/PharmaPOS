{
  "name": "pharma-pos",
  "version": "2.0.2",
  "description": "Pharmacy POS Desktop Application",
  "main": ".vite/build/index.cjs",
  "author": "Rivi9",
  "homepage": "https://www.electronforge.io",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "npm run typecheck && electron-forge package",
    "make": "npm run typecheck && electron-forge make",
    "publish": "npm run typecheck && electron-forge release",
    "test:import": "node tests/unit/inventory-import.test.mjs",
    "test:pole": "node tests/unit/pole-display.test.mjs",
    "test:escpos": "node tests/unit/escpos-encoding.test.mjs",
    "test:dates": "node tests/unit/dates.test.mjs",
    "test:search": "node tests/unit/product-search.test.mjs",
    "test:unit": "npm run test:import && npm run test:pole && npm run test:escpos && npm run test:dates && npm run test:search",
    "pretest:e2e": "electron-forge package",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
