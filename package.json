    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "playwright": "^1.58.2",
    "prettier": "^3.7.4",
    "radix-ui": "^1.8.1",
    "react": "^19.2.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
